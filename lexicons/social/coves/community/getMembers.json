{
  "lexicon": 1,
  "id": "social.coves.community.getMembers",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get list of users with membership status in a community",
      "parameters": {
        "type": "params",
        "required": [
          "community"
        ],
        "properties": {
          "community": {
            "type": "string",
            "maxLength": 320,
            "description": "Community identifier: a DID (did:plc:...), an atProto handle (c-gaming.coves.social or gaming.coves.social), a scoped identifier with or without the ! prefix (gaming@coves.social, comicstrips@lemmy.world), or a bare name for a community on this instance (gaming)"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "maxLength": 500
          },
          "sort": {
            "type": "string",
            "knownValues": [
              "reputation",
              "recent",
              "alphabetical"
            ],
            "default": "reputation",
            "maxLength": 64
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": [
            "members"
          ],
          "properties": {
            "members": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#memberView"
              }
            },
            "cursor": {
              "type": "string",
              "maxLength": 500
            }
          }
        }
      }
    },
    "memberView": {
      "type": "object",
      "required": [
        "did",
        "memberSince"
      ],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "handle": {
          "type": "string",
          "format": "handle"
        },
        "displayName": {
          "type": "string",
          "maxGraphemes": 128,
          "maxLength": 1280
        },
        "avatar": {
          "type": "string",
          "format": "uri"
        },
        "memberSince": {
          "type": "string",
          "format": "datetime"
        },
        "reputation": {
          "type": "integer",
          "minimum": 0
        },
        "isModerator": {
          "type": "boolean"
        },
        "postCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of posts in this community"
        },
        "commentCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of comments in this community"
        }
      }
    }
  }
}
