{
  "lexicon": 1,
  "id": "social.coves.moderation.ban",
  "defs": {
    "main": {
      "type": "record",
      "description": "A ban record for a user in a community",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "community",
          "subject",
          "banType",
          "createdAt"
        ],
        "properties": {
          "community": {
            "type": "string",
            "format": "did",
            "description": "DID of the community"
          },
          "subject": {
            "type": "string",
            "format": "did",
            "description": "DID of the banned user"
          },
          "banType": {
            "type": "string",
            "knownValues": [
              "moderator",
              "tribunal"
            ],
            "description": "How the ban was imposed",
            "maxLength": 64
          },
          "reason": {
            "type": "string",
            "maxGraphemes": 2000,
            "maxLength": 20000,
            "description": "Reason for the ban"
          },
          "duration": {
            "type": "integer",
            "minimum": 1,
            "description": "Ban duration in hours (omit for permanent)"
          },
          "bannedBy": {
            "type": "string",
            "format": "did",
            "description": "DID of moderator who issued ban (omitted for tribunal bans)"
          },
          "tribunalCase": {
            "type": "ref",
            "ref": "com.atproto.repo.strongRef",
            "description": "Strong reference to the tribunal case that resulted in this ban"
          },
          "status": {
            "type": "string",
            "knownValues": [
              "active",
              "expired",
              "revoked"
            ],
            "maxLength": 64
          },
          "expiresAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the ban expires (omit for permanent)"
          },
          "revokedAt": {
            "type": "string",
            "format": "datetime",
            "description": "When the ban was revoked"
          },
          "revokedBy": {
            "type": "string",
            "format": "did",
            "description": "DID of moderator who revoked the ban"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
